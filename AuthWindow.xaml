<Window x:Class="SurgeApp.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SURGE — Account"
        Width="900" Height="650" MinWidth="820" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI" Loaded="Window_Loaded">

    <Grid>
        <Border x:Name="RootChrome" Opacity="0" CornerRadius="24" BorderBrush="#30334A" BorderThickness="1"
                Background="#080A12" Effect="{StaticResource ShadowCard}">
            <Border.RenderTransform><TranslateTransform Y="10"/></Border.RenderTransform>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.08*"/>
                    <ColumnDefinition Width="0.92*"/>
                </Grid.ColumnDefinitions>

                <!-- Ambient glass glow -->
                <Border Grid.ColumnSpan="2" CornerRadius="24" IsHitTestVisible="False">
                    <Border.Background>
                        <RadialGradientBrush Center="0.10,0.05" RadiusX="0.95" RadiusY="0.95">
                            <GradientStop Color="#1A1C38" Offset="0"/>
                            <GradientStop Color="#0B0C14" Offset="0.55"/>
                            <GradientStop Color="#080A12" Offset="1"/>
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Left brand / product story -->
                <Grid Grid.Column="0" Margin="38,34,30,34">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="46" Height="46" CornerRadius="14"
                                    Background="{StaticResource LogoGradientBrush}"
                                    Effect="{StaticResource GlowBlue}">
                                <Grid>
                                    <Border Width="24" Height="24" CornerRadius="7" Background="#FFFFFF" Opacity="0.22"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Width="4" Height="18" CornerRadius="2" Background="#FFFFFF" Margin="0,0,3,0"/>
                                        <Border Width="4" Height="18" CornerRadius="2" Background="#FFFFFF" Margin="0,0,3,0"/>
                                        <Border Width="4" Height="18" CornerRadius="2" Background="#FFFFFF"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="SURGE" FontSize="25" FontWeight="Bold" Foreground="#F8F7FF"/>
                                <TextBlock Text="FLIGHT TUNING SUITE" FontSize="10" FontWeight="SemiBold" Foreground="#777C98" Margin="0,3,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Content="✕" Width="34" Height="30" Style="{StaticResource TitleBarButton}" Click="Close_Click"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="450">
                        <Border HorizontalAlignment="Left" Padding="10,5" CornerRadius="9"
                                Background="#121528" BorderBrush="#282D48" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#3FD8A1" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="SECURE ACCOUNT ACCESS" FontSize="10" FontWeight="SemiBold" Foreground="#9EA5C3"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Tune Windows with control."
                                   FontSize="34" FontWeight="SemiBold" Foreground="#F5F2FF"
                                   LineHeight="40" Margin="0,18,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="Sign in to unlock your licensed tuning library, device-bound activation, and Surge account services."
                                   FontSize="13" Foreground="#8B90A9" Margin="0,12,0,0"
                                   LineHeight="21" TextWrapping="Wrap"/>

                        <Grid Margin="0,28,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="DEVICE BOUND" FontSize="10" FontWeight="SemiBold" Foreground="#676D86"/>
                                <TextBlock Text="ECDSA" FontSize="14" FontWeight="SemiBold" Foreground="#DCE1F0" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="TOKEN STORE" FontSize="10" FontWeight="SemiBold" Foreground="#676D86"/>
                                <TextBlock Text="DPAPI" FontSize="14" FontWeight="SemiBold" Foreground="#DCE1F0" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="VALIDATION" FontSize="10" FontWeight="SemiBold" Foreground="#676D86"/>
                                <TextBlock Text="SERVER" FontSize="14" FontWeight="SemiBold" Foreground="#DCE1F0" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <Border Height="1" Background="#1C2031"/>
                        <TextBlock Text="Licensed features stay bound to this installation and account."
                                   Foreground="#656B83" FontSize="10.5" Margin="0,14,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Right auth surface -->
                <Grid Grid.Column="1" Margin="16,24,24,24">
                    <Border CornerRadius="20" Background="#0F111B" BorderBrush="#25293E" BorderThickness="1" Padding="28,30">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="WELCOME BACK" FontSize="10" FontWeight="Bold" Foreground="#7F87A5"/>
                                <TextBlock Text="Sign in to Surge" FontSize="27" FontWeight="SemiBold" Foreground="#F3F1FB" Margin="0,7,0,0"/>
                                <TextBlock Text="Use your account to continue to the tuning suite."
                                           FontSize="12" Foreground="#81869D" Margin="0,7,0,10" TextWrapping="Wrap"/>

                                <Border x:Name="LoginPanel" Background="#121522" BorderBrush="#282D43" BorderThickness="1" CornerRadius="15" Padding="17">
                                    <StackPanel>
                                        <TextBlock Text="EMAIL" FontSize="10" FontWeight="SemiBold" Foreground="#777D97"/>
                                        <TextBox x:Name="EmailBox" Height="44" Margin="0,7,0,15" Padding="12" FontSize="13"
                                                 Style="{StaticResource ModernAuthTextBox}"/>

                                        <TextBlock Text="PASSWORD" FontSize="10" FontWeight="SemiBold" Foreground="#777D97"/>
                                        <PasswordBox x:Name="PasswordBox" Height="44" Margin="0,7,0,18" Padding="12" FontSize="13"
                                                     Style="{StaticResource ModernAuthPasswordBox}"/>

                                        <Button x:Name="LoginButton" Content="Sign in" Height="46" Style="{StaticResource ModernPrimaryButton}" Click="Login_Click"/>
                                        <Button x:Name="RegisterButton" Content="Create a new account" Height="42" Margin="0,10,0,0" Style="{StaticResource ModernSecondaryButton}" Click="Register_Click"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="AccountPanel" Visibility="Collapsed" Background="#121522" BorderBrush="#282D43" BorderThickness="1" CornerRadius="15" Padding="17" Margin="0,4,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Padding="8,4" CornerRadius="8" Background="#12231F" BorderBrush="#234F42" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Fill="#30D3A0" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                    <TextBlock Text="CONNECTED" FontSize="10" FontWeight="Bold" Foreground="#78DCC0"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="AccountEmailText" FontSize="16" FontWeight="SemiBold" Foreground="#F0F0F8" Margin="0,14,0,2"/>
                                        <TextBlock x:Name="DeviceText" Foreground="#777D94" FontSize="11"/>

                                        <Border Margin="0,18,0,0" Padding="13" CornerRadius="12" Background="#0D0F18" BorderBrush="#252A3E" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="LICENSE STATUS" FontSize="10" FontWeight="Bold" Foreground="#70768F"/>
                                                    <TextBlock x:Name="LicenseStatusText" Text="Not activated" Foreground="#DDE0EC" FontSize="14" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                                    <TextBlock x:Name="LicenseDetailText" Foreground="#747A91" FontSize="10.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Ellipse x:Name="LicenseDot" Grid.Column="1" Width="9" Height="9" VerticalAlignment="Top" Fill="#777B90"/>
                                            </Grid>
                                        </Border>

                                        <TextBlock Text="LICENSE KEY" FontSize="10" FontWeight="Bold" Foreground="#777D97" Margin="0,18,0,0"/>
                                        <TextBox x:Name="LicenseKeyBox" Height="44" Margin="0,7,0,11" Padding="12" FontSize="13"
                                                 Style="{StaticResource ModernAuthTextBox}"/>
                                        <Button x:Name="ActivateButton" Content="Activate license" Height="45" Style="{StaticResource ModernPrimaryButton}" Click="Activate_Click"/>
                                        <Button x:Name="OpenButton" Content="Open Surge" Height="46" Margin="0,14,0,0" Style="{StaticResource ModernPrimaryButton}" Click="Open_Click" Visibility="Collapsed"/>
                                        <Button x:Name="SignOutButton" Content="Sign out" Height="40" Margin="0,10,0,0" Style="{StaticResource ModernSecondaryButton}" Click="SignOut_Click" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#0B0D15" BorderBrush="#1D2131" BorderThickness="1" CornerRadius="10" Padding="11,9" Margin="0,14,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="●" Foreground="#4D6FFF" FontSize="9" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Secure session · device-bound activation · server validation"
                                                   Foreground="#6F758C" FontSize="10" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Name="StatusText" Text="" Foreground="#FF8795" FontSize="11" TextWrapping="Wrap" Margin="2,12,2,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
