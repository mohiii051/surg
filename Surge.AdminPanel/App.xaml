<Application x:Class="Surge.AdminPanel.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="BgBrush" Color="#080B13"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#111827"/>
    <SolidColorBrush x:Key="Panel2Brush" Color="#0D1422"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#27334A"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F5F7FB"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#9AA7BF"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#6D8CFF"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#43D19E"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF6B7A"/>

    <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Style>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#26324D"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#33415F"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="4"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#536DDB"/><Setter Property="BorderBrush" Value="#6D8CFF"/></Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#542B35"/><Setter Property="BorderBrush" Value="#8A3D4A"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#151D2D"/><Setter Property="Foreground" Value="#F5F7FB"/><Setter Property="BorderBrush" Value="#34415A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="4"/></Style>
    <Style TargetType="PasswordBox"><Setter Property="Background" Value="#151D2D"/><Setter Property="Foreground" Value="#F5F7FB"/><Setter Property="BorderBrush" Value="#34415A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="4"/></Style>
    <Style TargetType="TabControl">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#AEBBD2"/>
      <Setter Property="Background" Value="#0D1422"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="#27334A" BorderThickness="1" CornerRadius="9,9,0,0" Padding="2">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" ContentSource="Header" Margin="14,8"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="#1A2438"/>
                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#536DDB"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="#151F33"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="ColumnHeaderHeight" Value="40"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="Foreground" Value="#EAF0FA"/>
      <Setter Property="Background" Value="#0D1422"/><Setter Property="Foreground" Value="#EAF0FA"/><Setter Property="BorderBrush" Value="#2A3851"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="RowBackground" Value="#101827"/><Setter Property="AlternatingRowBackground" Value="#0D1422"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#253249"/>
      <Setter Property="VerticalGridLinesBrush" Value="#253249"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="CanUserResizeRows" Value="False"/><Setter Property="RowHeight" Value="34"/>
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="Foreground" Value="#EAF0FA"/>
      <Setter Property="Background" Value="#101827"/>
      <Setter Property="BorderBrush" Value="#253249"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#17233A"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#263C72"/></Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="GridCellTextStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#EAF0FA"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#1A2436"/>
      <Setter Property="Foreground" Value="#F5F7FB"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="BorderBrush" Value="#2A3851"/>
      <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>

    <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="#EAF0FA"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="8,5"/><Setter Property="BorderThickness" Value="0"/></Style>
  </Application.Resources>
</Application>
