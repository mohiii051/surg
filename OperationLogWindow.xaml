<Window x:Class="SurgeApp.OperationLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SURGE — Operation Log" Width="980" Height="660"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI"
        ShowInTaskbar="False" Loaded="Window_Loaded">
    <Border x:Name="Root" CornerRadius="20" Background="#0A0C14" BorderBrush="#2A2F47" BorderThickness="1" Padding="18" Opacity="0">
        <Border.RenderTransform><TranslateTransform Y="10"/></Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="1"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="4,0,4,14">
                <StackPanel>
                    <TextBlock Text="OPERATION LOG" FontSize="10" FontWeight="SemiBold" Foreground="#65C8FF"/>
                    <TextBlock Text="Protected tuning history" FontSize="23" FontWeight="SemiBold" Foreground="#F4F1FA" Margin="0,3,0,0"/>
                    <TextBlock x:Name="IntegrityText" Text="Verifying integrity…" FontSize="10.5" Foreground="#8F95AA" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button x:Name="ExportButton" Content="Export CSV" Style="{StaticResource ModernCardActionButton}" Height="30" Click="Export_Click" Margin="0,0,8,0"/>
                    <Button Content="×" Style="{StaticResource TitleBarButton}" Width="34" Height="30" Click="Close_Click"/>
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Background="#1B1E2A"/>
            <Grid Grid.Row="2" Margin="0,12,0,14">
                <DataGrid x:Name="LogGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" Background="Transparent" BorderThickness="0"
                          Foreground="#E9E8F1" RowBackground="#10131E" AlternatingRowBackground="#0D1018"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1C2030" FontSize="10.5">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#121521"/><Setter Property="Foreground" Value="#8F96AE"/>
                            <Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="8,7"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#24283A"/>
                        </Style>
                        <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,6"/></Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="TIME" Binding="Time" Width="150"/>
                        <DataGridTextColumn Header="TWEAK" Binding="Title" Width="*"/>
                        <DataGridTextColumn Header="ACTION" Binding="Action" Width="85"/>
                        <DataGridTextColumn Header="RESULT" Binding="Result" Width="90"/>
                        <DataGridTextColumn Header="STATE" Binding="State" Width="110"/>
                        <DataGridTextColumn Header="MESSAGE" Binding="Message" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="EmptyText" Text="No tuning operations have been recorded yet." Foreground="#7F8599" FontSize="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
            <TextBlock Grid.Row="3" Text="Secure log · integrity verified before display" Foreground="#656B80" FontSize="9.5"/>
        </Grid>
    </Border>
</Window>
