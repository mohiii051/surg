<Window x:Class="SurgeApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SurgeApp"
        Title="SURGE — Flight Tuning Suite"
        Width="1540" Height="850"
        MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Loaded="Window_Loaded"
        StateChanged="Window_StateChanged">

    <Window.Resources>
        <local:StatusToBrushConverter x:Key="StatusToBrush"/>
        <local:StatusToTextBrushConverter x:Key="StatusToTextBrush"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <DataTemplate x:Key="TweakCardTemplate">
            <Border Style="{StaticResource ModernCard}" Margin="0,0,12,12" Width="360" Height="228"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0">
                <Border.RenderTransform>
                    <TranslateTransform Y="10"/>
                </Border.RenderTransform>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.24"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" To="0" Duration="0:0:0.32" DecelerationRatio="0.75"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{Binding StatusText, Converter={StaticResource StatusToBrush}}"
                                BorderBrush="#2A2D40" BorderThickness="1" CornerRadius="10" Padding="8,3" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"
                                         Fill="{Binding StatusText, Converter={StaticResource StatusToTextBrush}}" Effect="{StaticResource GlowGreen}"/>
                                <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{Binding StatusText, Converter={StaticResource StatusToTextBrush}}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Tags}" Margin="0,7,0,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TagChip}">
                                    <TextBlock Text="{Binding}" Style="{StaticResource TagChipText}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,2,0,0" Height="56">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource CardDescription}" TextWrapping="Wrap"
                                   VerticalAlignment="Top" MaxHeight="42" TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="1" Content="Read more…" Style="{StaticResource InlineLinkButton}"
                                Click="ReadMore_Click" VerticalAlignment="Bottom" Margin="8,0,0,0"/>
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#151724" BorderBrush="#282B40" BorderThickness="1" CornerRadius="8" Padding="7,3" Margin="0,0,6,0">
                                <TextBlock Text="{Binding Risk}" FontSize="10" Foreground="#AEB3C7"/>
                            </Border>
                            <Border Background="#151724" BorderBrush="#282B40" BorderThickness="1" CornerRadius="8" Padding="7,3"
                                    Visibility="{Binding RequiresReboot, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="REBOOT" FontSize="10" Foreground="#AEB3C7"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding VerificationText}" Foreground="{StaticResource TextMutedBrush}" FontSize="10"
                                       VerticalAlignment="Center" Margin="0,0,10,0" MaxWidth="132" TextTrimming="CharacterEllipsis"/>
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsApplied, Mode=OneWay}"
                                      IsEnabled="{Binding CanApplyFromUi}" ToolTip="{Binding Title}" Click="TweakToggle_Click" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                </StackPanel>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <Border x:Name="RootChrome" Opacity="0"
            CornerRadius="24"
            BorderBrush="#2A2E49"
            BorderThickness="1"
            Background="#090B14"
            SizeChanged="RootChrome_SizeChanged"
            SnapsToDevicePixels="True">
        <Border.RenderTransform>
            <TranslateTransform Y="10"/>
        </Border.RenderTransform>
        <Grid ClipToBounds="True">
            <Canvas Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="True">
                <Ellipse x:Name="AmbientGlowA" Width="500" Height="500" Canvas.Left="-230" Canvas.Top="-250" Opacity="0.11" Fill="#7568FF" Effect="{StaticResource AtmosphereBlur}"/>
                <Ellipse x:Name="AmbientGlowB" Width="520" Height="520" Canvas.Left="1080" Canvas.Top="300" Opacity="0.045" Fill="#35B9FF" Effect="{StaticResource AtmosphereBlur}"/>
            </Canvas>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="#0D0F18"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <Ellipse Width="6" Height="6" Fill="#51BFFF" Effect="{StaticResource GlowBlue}" Margin="0,0,8,0"/>
                        <TextBlock Text="SURGE" Foreground="#DADBF0" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock Text="  /  v2.1.0" Foreground="#6F748B" FontSize="10" FontFamily="Consolas"/>
                    </StackPanel>
                    <TextBlock Text="v2.1.0" Foreground="#777A8F" FontSize="12"
                               VerticalAlignment="Center" Margin="22,0,0,0" FontFamily="Consolas" Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Click="Minimize_Click"/>
                        <Button Style="{StaticResource TitleBarButton}" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" Click="Maximize_Click"/>
                        <Button Style="{StaticResource TitleBarButton}" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Click="Close_Click"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sidebar -->
                    <Border Grid.Column="0" Background="{StaticResource BgSidebarBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="108"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="18,18,18,0" HorizontalAlignment="Stretch">
                                <Border Width="46" Height="46" CornerRadius="14"
                                        Background="{StaticResource LogoGradientBrush}"
                                        Effect="{StaticResource GlowBlue}"
                                        HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Grid>
                                        <TextBlock Text="▮▮▮▮" FontSize="13" FontWeight="Bold"
                                                   Foreground="#F8FAFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <StackPanel Margin="61,1,0,0" HorizontalAlignment="Left">
                                    <TextBlock Text="SURGE" FontSize="21" FontWeight="Bold" Foreground="#F6F3FF"/>
                                    <TextBlock Text="Flight Tuning Suite" FontSize="12" Foreground="#85899E" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" Margin="16,0,16,14" Padding="14,13"
                                    CornerRadius="14" Background="{StaticResource BgPanelBrush}"
                                    BorderBrush="#282A3D" BorderThickness="1" Effect="{StaticResource ShadowPanel}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentGreenBrush}"
                                                 VerticalAlignment="Center" Effect="{StaticResource GlowGreen}">
                                            <Ellipse.Triggers>
                                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.45" To="1" Duration="0:0:1.3"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Ellipse.Triggers>
                                        </Ellipse>
                                        <TextBlock Text="SYSTEM" Style="{StaticResource SidebarSectionLabel}" Margin="9,0,0,0"/>
                                    </StackPanel>
                                    <Border Margin="0,0,0,10" Padding="9" CornerRadius="11" Background="#11131F" BorderBrush="#2A2D40" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="ACCOUNT" Style="{StaticResource SidebarSectionLabel}"/>
                                                <TextBlock x:Name="AccountEmailText" Text="-" Foreground="#E4E6F0" FontSize="12" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock x:Name="LicenseStatusText" Text="LICENSE INACTIVE" Foreground="#FF8795" FontSize="10" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                                <TextBlock x:Name="LicenseDetailText" Text="No active license" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Ellipse x:Name="LicenseDot" Grid.Column="1" Width="9" Height="9" Fill="#FF8795" VerticalAlignment="Top"/>
                                        </Grid>
                                    </Border>
                                    <Button x:Name="AccountCenterButton" Content="Account center" Height="32" Margin="0,0,0,6" Style="{StaticResource ModernSecondaryButton}" Click="AccountCenter_Click"/>
                                    <Grid Margin="0,0,0,10"><TextBlock Text="OS" Foreground="#777B90" FontSize="12"/><TextBlock Text="Windows 11 Pro 25H2" Foreground="#E1E2EA" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/></Grid>
                                    <Border Margin="0,0,0,10" Padding="10,9" CornerRadius="11" Background="#0D0F18" BorderBrush="#25283A" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="SYSTEM RESTORE" Style="{StaticResource SidebarSectionLabel}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <Ellipse x:Name="RestorePointStatusDot" Width="7" Height="7" Fill="#B4BACB" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                    <TextBlock x:Name="RestorePointStatusText" Text="Checking…" Foreground="#AEB3C7" FontSize="10.5"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button x:Name="CreateRestorePointButton" Grid.Column="1" Content="Create" Style="{StaticResource ModernCardActionButton}" Height="28" MinWidth="72" Click="CreateRestorePoint_Click"/>
                                        </Grid>
                                    </Border>
                                    <Border BorderThickness="0,1,0,0" BorderBrush="#252739" Margin="0,0,0,12"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="#102B23" BorderBrush="#198863" BorderThickness="1" CornerRadius="15" Padding="11,6" Margin="0,0,7,0">
                                            <TextBlock Text="Administrator" Foreground="#44D5A4" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border Background="#101E29" BorderBrush="#27516D" BorderThickness="1" CornerRadius="15" Padding="9,6">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Fill="#30D3A0" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Updates: ON" Foreground="#B9C3D0" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Grid.Row="2" Text="CATEGORIES" Style="{StaticResource SidebarSectionLabel}" Margin="22,0,18,4"/>

                            <ListBox x:Name="CategoryList" Grid.Row="3" Margin="12,0,8,4"
                                     SelectionChanged="CategoryList_SelectionChanged"
                                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VerticalContentAlignment="Top"
                                     Padding="0,0,0,2"/>

                            <Border Grid.Row="4" Margin="16,5,16,12" Padding="7" CornerRadius="13"
                                    Background="#10121B" BorderBrush="#25283A" BorderThickness="1"
                                    Effect="{StaticResource ShadowPanel}">
                                <StackPanel>
                                                                        <Button x:Name="ApplyAllButton" Content="✓  Apply all tweaks" Style="{StaticResource ModernPrimaryButton}" Height="38" Margin="0,0,0,6" Click="ApplyAll_Click" IsEnabled="{Binding IsTuningAllowed, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <Button x:Name="CancelApplyAllButton" Content="Cancel apply" Style="{StaticResource ModernSecondaryButton}" Height="32" Margin="0,0,0,8" Click="CancelApplyAll_Click" Visibility="Collapsed" IsEnabled="{Binding IsTuningAllowed, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <Button x:Name="RevertAllButton" Content="Revert all tweaks" Style="{StaticResource ModernSecondaryButton}" Height="38" Margin="0,0,0,6" Click="RevertAll_Click" IsEnabled="{Binding IsTuningAllowed, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <Button Content="View operation log" Style="{StaticResource ModernSecondaryButton}" Height="34" Click="OpenLog_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Background="#202234"/>

                    <!-- Main content -->
                    <Grid Grid.Column="2" Background="{StaticResource BgContentBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="132"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Canvas IsHitTestVisible="False" ClipToBounds="True">
                            <Ellipse Width="420" Height="420" Canvas.Left="620" Canvas.Top="-180" Fill="#655BFF" Opacity="0.045" Effect="{StaticResource AtmosphereBlur}"/>
                            <Ellipse Width="360" Height="360" Canvas.Left="260" Canvas.Top="520" Fill="#3CB8FF" Opacity="0.028" Effect="{StaticResource AtmosphereBlur}"/>
                        </Canvas>

                        <Grid Grid.Row="0" Margin="24,16,22,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="360"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <Border HorizontalAlignment="Left" Padding="9,5" CornerRadius="9" Background="#11152A" BorderBrush="#262B47" BorderThickness="1" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="#59C8FF" Effect="{StaticResource GlowBlue}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="SECURE TUNING SESSION" FontSize="9.5" FontWeight="SemiBold" Foreground="#9299B7"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Tuning Library" Style="{StaticResource HeaderTitle}"/>
                                <TextBlock Style="{StaticResource HeaderSubtitle}">
                                    <Run x:Name="ResultCountRun" Text="0"/>
                                    <Run Text=" tweaks · "/>
                                    <Run x:Name="AppliedCountRun" Text="0"/>
                                    <Run Text=" applied · "/><Run x:Name="LibraryCountRun" Text="100"/><Run Text=" total"/>
                                </TextBlock>
                                <TextBlock x:Name="ScanStatusText" Text="System scan pending…" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Height="40" VerticalAlignment="Center"
                                    Background="#0D1019" CornerRadius="12"
                                    BorderBrush="#272C43" BorderThickness="1" Padding="13,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="⌕" FontSize="19" Foreground="#777B90" VerticalAlignment="Center" Margin="0,0,8,1"/>
                                    <TextBox Grid.Column="1" x:Name="SearchBox" Style="{StaticResource ModernSearchBox}" TextChanged="SearchBox_TextChanged"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <Border Grid.Row="1" Background="#161827"/>

                        <ScrollViewer x:Name="LibraryScroll" Grid.Row="2" Margin="24,12,16,16"
                                      Padding="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="False"
                                      HorizontalContentAlignment="Left">
                            <ItemsControl x:Name="TweaksItemsControl"
                                          IsEnabled="{Binding IsTuningAllowed, RelativeSource={RelativeSource AncestorType=Window}}"
                                          ItemTemplate="{StaticResource TweakCardTemplate}"
                                          HorizontalAlignment="Left">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Top"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
        <Border.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.34"/>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" To="0" Duration="0:0:0.44" DecelerationRatio="0.82"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>
    </Border>
</Window>
