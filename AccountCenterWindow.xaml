<Window x:Class="SurgeApp.AccountCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SURGE — Account Center" Width="980" Height="700" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Border x:Name="RootChrome" Opacity="0" CornerRadius="24" BorderBrush="#30334A" BorderThickness="1" Background="#080A12" Effect="{StaticResource ShadowCard}">
        <Border.RenderTransform><TranslateTransform Y="10"/></Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="72"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="28,20">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource LogoGradientBrush}" Effect="{StaticResource GlowBlue}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="4" Height="17" CornerRadius="2" Background="#FFF" Margin="0,0,3,0"/><Border Width="4" Height="17" CornerRadius="2" Background="#FFF" Margin="0,0,3,0"/><Border Width="4" Height="17" CornerRadius="2" Background="#FFF"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ACCOUNT CENTER" FontSize="11" FontWeight="Bold" Foreground="#7F87A5"/>
                        <TextBlock Text="Your Surge account" FontSize="22" FontWeight="SemiBold" Foreground="#F5F2FF" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Width="34" Height="30" Style="{StaticResource TitleBarButton}" Click="Close_Click"/>
            </Grid>
            <Grid Grid.Row="1" Margin="28,6,28,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <Border CornerRadius="18" Background="#11131F" BorderBrush="#282D43" BorderThickness="1" Padding="20" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="ACCOUNT" FontSize="10" FontWeight="Bold" Foreground="#737A93"/>
                            <TextBlock x:Name="EmailText" FontSize="20" FontWeight="SemiBold" Foreground="#F2F0F8" Margin="0,6,0,0"/>
                            <TextBlock x:Name="AccountSinceText" FontSize="11" Foreground="#747A90" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="18" Background="#11131F" BorderBrush="#282D43" BorderThickness="1" Padding="20">
                        <StackPanel>
                            <Grid><TextBlock Text="DEVICE" FontSize="10" FontWeight="Bold" Foreground="#737A93"/><TextBlock Text="THIS PC" HorizontalAlignment="Right" FontSize="10" FontWeight="Bold" Foreground="#58DCAF"/></Grid>
                            <TextBlock x:Name="DeviceNameText" FontSize="16" FontWeight="SemiBold" Foreground="#ECEAF4" Margin="0,7,0,0"/>
                            <TextBlock x:Name="DeviceIdText" FontSize="11" Foreground="#70768E" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            <Grid Margin="0,15,0,0"><TextBlock Text="First seen" Foreground="#70768E" FontSize="11"/><TextBlock x:Name="FirstSeenText" HorizontalAlignment="Right" Foreground="#D9DAE4" FontSize="11"/></Grid>
                            <Grid Margin="0,7,0,0"><TextBlock Text="Last seen" Foreground="#70768E" FontSize="11"/><TextBlock x:Name="LastSeenText" HorizontalAlignment="Right" Foreground="#D9DAE4" FontSize="11"/></Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <Border CornerRadius="18" Background="#11131F" BorderBrush="#282D43" BorderThickness="1" Padding="20">
                        <StackPanel>
                            <Grid><TextBlock Text="LICENSE" FontSize="10" FontWeight="Bold" Foreground="#737A93"/><TextBlock x:Name="LicenseStatusText" HorizontalAlignment="Right" FontSize="10" FontWeight="Bold" Foreground="#58DCAF"/></Grid>
                            <TextBlock x:Name="PlanText" FontSize="24" FontWeight="SemiBold" Foreground="#F2F0F8" Margin="0,7,0,0"/>
                            <TextBlock x:Name="LicenseIdText" FontSize="11" Foreground="#70768E" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            <Grid Margin="0,16,0,0"><TextBlock Text="Devices" Foreground="#70768E" FontSize="11"/><TextBlock x:Name="DevicesText" HorizontalAlignment="Right" Foreground="#E0E1EA" FontSize="12" FontWeight="SemiBold"/></Grid>
                            <Grid Margin="0,8,0,0"><TextBlock Text="Expires" Foreground="#70768E" FontSize="11"/><TextBlock x:Name="ExpiresText" HorizontalAlignment="Right" Foreground="#E0E1EA" FontSize="11"/></Grid>
                            <Border Margin="0,16,0,0" Padding="11" CornerRadius="10" Background="#0C0F18" BorderBrush="#22283A" BorderThickness="1">
                                <StackPanel><TextBlock Text="LICENSE KEY" FontSize="9" FontWeight="Bold" Foreground="#747B94"/><TextBlock x:Name="MaskedKeyText" FontFamily="Consolas" FontSize="12" Foreground="#D8DBE8" Margin="0,5,0,0"/></StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="18" Background="#0E101A" BorderBrush="#252A3E" BorderThickness="1" Padding="18" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="SECURITY" FontSize="10" FontWeight="Bold" Foreground="#737A93"/>
                            <TextBlock Text="Online validation is mandatory. Offline tuning is disabled." FontSize="12" Foreground="#C5C8D5" Margin="0,7,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="Device credentials are protected with Windows DPAPI and the device key stays bound to this installation." FontSize="11" Foreground="#6F758C" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="2" Margin="28,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0" Padding="10,7" CornerRadius="9" Background="#0D1018" BorderBrush="#24293A" BorderThickness="1" MaxWidth="470">
                    <TextBlock x:Name="StatusText" Foreground="#FF8795" FontSize="11" TextWrapping="Wrap"/>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="RefreshButton" Content="Refresh from server" Width="165" Height="40" Margin="0,0,10,0" Style="{StaticResource ModernSecondaryButton}" Click="Refresh_Click"/>
                    <Button x:Name="SignOutButton" Content="Sign out" Width="110" Height="40" Margin="0,0,10,0" Style="{StaticResource ModernSecondaryButton}" Click="SignOut_Click"/>
                    <Button Content="Close" Width="95" Height="40" Style="{StaticResource ModernPrimaryButton}" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>