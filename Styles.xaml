<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BgWindowColor">#090A12</Color>
    <Color x:Key="BgTitleBarColor">#12121E</Color>
    <Color x:Key="BgSidebarColor">#0C0D16</Color>
    <Color x:Key="BgContentColor">#0A0B13</Color>
    <Color x:Key="BgCardColor">#141622</Color>
    <Color x:Key="BgPanelColor">#10111A</Color>
    <Color x:Key="BgInputColor">#11121D</Color>
    <Color x:Key="BorderColor">#232638</Color>
    <Color x:Key="BorderSoftColor">#1B1D2A</Color>
    <Color x:Key="AccentBlueColor">#48B8FF</Color>
    <Color x:Key="AccentPurpleColor">#7D6EFF</Color>
    <Color x:Key="AccentGreenColor">#35D49A</Color>
    <Color x:Key="TextPrimaryColor">#F3F1F9</Color>
    <Color x:Key="TextSecondaryColor">#9296AB</Color>
    <Color x:Key="TextMutedColor">#6F7388</Color>

    <SolidColorBrush x:Key="BgWindowBrush" Color="{StaticResource BgWindowColor}"/>
    <SolidColorBrush x:Key="BgTitleBarBrush" Color="{StaticResource BgTitleBarColor}"/>
    <SolidColorBrush x:Key="BgSidebarBrush" Color="{StaticResource BgSidebarColor}"/>
    <SolidColorBrush x:Key="BgContentBrush" Color="{StaticResource BgContentColor}"/>
    <SolidColorBrush x:Key="BgPanelBrush" Color="{StaticResource BgPanelColor}"/>
    <SolidColorBrush x:Key="BgInputBrush" Color="{StaticResource BgInputColor}"/>
    <SolidColorBrush x:Key="BorderBrush1" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderSoftBrush" Color="{StaticResource BorderSoftColor}"/>
    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlueColor}"/>
    <SolidColorBrush x:Key="AccentPurpleBrush" Color="{StaticResource AccentPurpleColor}"/>
    <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreenColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>

    <LinearGradientBrush x:Key="LogoGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7F72FF" Offset="0"/><GradientStop Color="#3DB7FF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ApplyAllGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#8874FF" Offset="0"/><GradientStop Color="#36B7FF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SelectionGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#211B43" Offset="0"/><GradientStop Color="#1A1834" Offset="1"/>
    </LinearGradientBrush>

    <DropShadowEffect x:Key="ShadowCard" BlurRadius="28" ShadowDepth="0" Opacity="0.34" Color="#000000"/>
    <DropShadowEffect x:Key="ShadowButton" BlurRadius="22" ShadowDepth="0" Opacity="0.30" Color="#000000"/>
    <DropShadowEffect x:Key="ShadowPanel" BlurRadius="26" ShadowDepth="0" Opacity="0.28" Color="#000000"/>
    <DropShadowEffect x:Key="GlowPurple" BlurRadius="26" ShadowDepth="0" Opacity="0.38" Color="#7568FF"/>
    <DropShadowEffect x:Key="GlowBlue" BlurRadius="30" ShadowDepth="0" Opacity="0.40" Color="#3EB8FF"/>
    <DropShadowEffect x:Key="GlowGreen" BlurRadius="16" ShadowDepth="0" Opacity="0.55" Color="#2DDD9E"/>
    <BlurEffect x:Key="AtmosphereBlur" Radius="50"/>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="5"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template><ControlTemplate TargetType="Thumb"><Border CornerRadius="4" Background="#32354C" Margin="1"/></ControlTemplate></Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TextBase" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>
    <Style x:Key="HeaderTitle" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style x:Key="HeaderSubtitle" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/><Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="CardDescription" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="11.5"/><Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="16"/>
    </Style>
    <Style x:Key="SidebarSectionLabel" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="10.5"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
    </Style>

    <Style x:Key="StatusPill" TargetType="Border">
        <Setter Property="Background" Value="#102D24"/><Setter Property="BorderBrush" Value="#1B6A54"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="6,2"/>
    </Style>
    <Style x:Key="TagChip" TargetType="Border">
        <Setter Property="Background" Value="#191B2A"/><Setter Property="BorderBrush" Value="#25283A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="5"/><Setter Property="Padding" Value="6,2"/><Setter Property="Margin" Value="0,0,6,6"/>
    </Style>
    <Style x:Key="TagChipText" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="10.5"/><Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>

    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="42" Height="24">
                        <Border x:Name="TrackOff" Width="42" Height="24" CornerRadius="12" Background="#202234" BorderBrush="#30344A" BorderThickness="1" HorizontalAlignment="Left"/>
                        <Border x:Name="TrackOn" Width="42" Height="24" CornerRadius="12" HorizontalAlignment="Left" Opacity="0" Background="{StaticResource ApplyAllGradientBrush}"/>
                        <Ellipse x:Name="Knob" Width="18" Height="18" Fill="#F8F9FF" HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="TrackOff" Property="Opacity" Value="0.45"/>
                            <Setter TargetName="TrackOn" Property="Opacity" Value="0.25"/>
                            <Setter TargetName="Knob" Property="Opacity" Value="0.60"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/><ThicknessAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="Margin" To="21,0,0,0" Duration="0:0:0.14"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14"/><ThicknessAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="Margin" To="3,0,0,0" Duration="0:0:0.14"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CountBadge" TargetType="Border">
        <Setter Property="Background" Value="#171925"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="7,2"/><Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>

    <Style x:Key="ModernCategoryItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="11" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="AccentBar" Width="3" HorizontalAlignment="Left" VerticalAlignment="Stretch" CornerRadius="2" Background="#51BFFF" Visibility="Collapsed" Margin="0,7,0,7" Effect="{StaticResource GlowBlue}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#171832"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#3B3A73"/>
                            <Setter TargetName="AccentBar" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="#121526"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#282C44"/>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ItemContainerStyle" Value="{StaticResource ModernCategoryItem}"/></Style>

    <Style x:Key="ModernCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Effect" Value="{StaticResource ShadowCard}"/>
        <Setter Property="Background" Value="#11131F"/>
        <Setter Property="BorderBrush" Value="#262A40"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value></Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.006" Duration="0:0:0.18"/>
                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.006" Duration="0:0:0.18"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.18"/>
                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.18"/>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                <Setter Property="Background" Value="#14172A"/>
                <Setter Property="BorderBrush" Value="#3C4164"/>
                <Setter Property="Effect" Value="{StaticResource GlowPurple}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.65"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ModernPrimaryButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="{StaticResource ApplyAllGradientBrush}"/>
        <Setter Property="Effect" Value="{StaticResource ShadowButton}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Glow" CornerRadius="12" Background="{TemplateBinding Background}" Opacity="0.30" Effect="{StaticResource GlowBlue}"/>
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12" BorderBrush="#5B6CFF" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.012" Duration="0:0:0.16"/>
                                <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.012" Duration="0:0:0.16"/>
                                <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.62" Duration="0:0:0.18"/>
                            </Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.18"/>
                                <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.18"/>
                                <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.30" Duration="0:0:0.18"/>
                            </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            <Setter TargetName="bd" Property="Opacity" Value="0.96"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.82"/>
                            <Setter TargetName="Glow" Property="Opacity" Value="0.38"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                            <Setter TargetName="Glow" Property="Opacity" Value="0.08"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="InlineLinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="#7FB9FF"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="9.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="2,1"/>
        <Setter Property="Opacity" Value="0.82"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="5" Padding="4,2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#151A2B"/>
                            <Setter Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#1B2035"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ModernSecondaryButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="#E7E6F4"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="#10121C"/>
        <Setter Property="BorderBrush" Value="#292D43"/>
        <Setter Property="Effect" Value="{StaticResource ShadowButton}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.008" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.008" Duration="0:0:0.15"/>
                            </Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15"/>
                            </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            <Setter TargetName="bd" Property="Background" Value="#171A2A"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="#465078"/>
                            <Setter TargetName="bd" Property="Effect" Value="{StaticResource GlowPurple}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#0D0F18"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernSearchBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/><Setter Property="CaretBrush" Value="{StaticResource AccentBlueBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,7"/><Setter Property="FontSize" Value="13"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Grid><TextBlock Text="Search tweaks, tags..." Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" x:Name="Placeholder" FontSize="13" Visibility="Collapsed"/><ScrollViewer x:Name="PART_ContentHost"/></Grid><ControlTemplate.Triggers><Trigger Property="Text" Value=""><Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="TitleBarButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/><Setter Property="Width" Value="42"/><Setter Property="Height" Value="32"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="bd" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#1A1B29"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#26273A"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="ModernCardActionButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="#EDEEFF"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#343850"/>
        <Setter Property="Background" Value="#151827"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.012" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.012" Duration="0:0:0.15"/>
                            </Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15"/>
                            </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            <Setter TargetName="bd" Property="Background" Value="#1B1E31"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="#4E5681"/>
                            <Setter TargetName="bd" Property="Effect" Value="{StaticResource GlowBlue}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#0F111A"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.38"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernAuthTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="#0C0F18"/>
        <Setter Property="Foreground" Value="#F4F2FA"/>
        <Setter Property="CaretBrush" Value="#52BFFF"/>
        <Setter Property="BorderBrush" Value="#2A2F45"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="#4B9CFF"/>
                            <Setter TargetName="bd" Property="Effect" Value="{StaticResource GlowBlue}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.48"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernAuthPasswordBox" TargetType="PasswordBox">
        <Setter Property="Background" Value="#0C0F18"/>
        <Setter Property="Foreground" Value="#F4F2FA"/>
        <Setter Property="CaretBrush" Value="#52BFFF"/>
        <Setter Property="BorderBrush" Value="#2A2F45"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="#4B9CFF"/>
                            <Setter TargetName="bd" Property="Effect" Value="{StaticResource GlowBlue}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.48"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
